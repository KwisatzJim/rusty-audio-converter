{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyAudioConverter",
  "version": "0.1.0",
  "identifier": "com.rustyaudioconverter.app",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run vite-dev",
    "beforeBuildCommand": "npm run vite-build"
  },
  "app": {
    "windows": [
      {
        "title": "RustyAudioConverter",
        "width": 900,
        "height": 680,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
